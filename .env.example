# Logto Configuration
# Get these values from your Logto Console: https://console.logto.io/

# Your Logto endpoint (e.g., https://your-app.logto.app)
VITE_LOGTO_ENDPOINT=

# Your Logto application ID
VITE_LOGTO_APP_ID=

# The redirect URI after successful authentication (must match your Logto app settings)
# For local development, use: http://localhost:5173/callback
VITE_LOGTO_REDIRECT_URI=http://localhost:5173/callback

# The URI to redirect after logout (must match your Logto app settings)
# For local development, use: http://localhost:5173
VITE_LOGTO_POST_LOGOUT_REDIRECT_URI=http://localhost:5173
